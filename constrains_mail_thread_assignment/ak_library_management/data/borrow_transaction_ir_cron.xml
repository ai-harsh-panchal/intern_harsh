<odoo>
    <record id="ir_cron_borrow_transaction" model="ir.cron">
        <field name="name">Borrow Transaction Reminder</field>
        <field name="model_id" ref="model_borrow_transaction_history"/>
        <field name="state">code</field>
        <field name="code">model.cron_check_due_date()</field>
        <field name='interval_number'>1</field>
        <field name='interval_number'>-1</field>
        <field name='interval_type'>hours</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
