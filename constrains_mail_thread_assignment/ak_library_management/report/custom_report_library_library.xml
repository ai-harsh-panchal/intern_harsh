<odoo>
    <template id="library_report_custom_template">
        <html>
            <body>
                <main>
                    <t t-foreach="docs" t-as="o">
                        <t class="article">
                            <!-- Custom Header -->
                            <div class="header">
                                <div class="logo" style ="text-align: left;">
                                    <p>Your Logo</p>
                                </div>
                                <div class="title" style="text-align: right;">
                                    <h3>Aktiv Software</h3>
                                    <div>10th Floor,Binori Bsquare 3,Sindhu Bhavan Road <br/>Ahmedabad</div>
                                    <div>info@aktivsoftware.com</div>
                                </div>
                            </div>
                            <div class="page">
                                <!-- Library Header Section -->
                                <div class="row mb-4">
                                    <div class="col-12">
                                        <t t-set="layout_document_title">
                                            <h4>Library Name #<span t-field="o.id"/>:
                                                <span t-field="o.name"/>
                                            </h4>
                                        </t>
                                    </div>
                                </div>

                                <!-- Library Details Section -->
                                <div class="row mb-4" id="library_informations">
                                    <div t-if="o.librarian_id" class="col" name="librarian_info">
                                        <strong>Librarian Name</strong>
                                        <div t-field="o.librarian_id.name"/>
                                    </div>
                                    <div t-if="o.date" class="col" name="date_info">
                                        <strong>Date</strong>
                                        <div t-field="o.date" t-options='{"format": "dd/MMM/YYYY"}'/>
                                    </div>

                                    <div t-if="o.book_count" class="col" name="book_count_info">
                                        <strong>Total Borrowed Books</strong>
                                        <div t-field="o.book_count"/>
                                    </div>

                                    <div t-if="o.location" class="col" name="location_info">
                                        <strong>Location</strong>
                                        <div t-field="o.location"/>
                                    </div>
                                </div>
                                <div class="row mb-4">
                                    <div class="col-12">
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    <th style="color: red;">Book</th>
                                                    <th style="color: red;">Price</th>
                                                    <th style="color: red;">Published Date</th>
                                                    <th style="color: red;">Author</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="o.book_ids" t-as="book">
                                                    <td>
                                                        <strong t-esc="book.barcode or 'No-ISBN'"/>
                                                        <br/>
                                                        <span t-field="book.name"/>
                                                        <br/>
                                                        On Hand:
                                                        <span t-field="book.qty_available"/>
                                                    </td>
                                                    <td>
                                                        <span t-field="book.list_price"/>
                                                    </td>
                                                    <td>
                                                        <span t-field="book.published_date"
                                                              t-options='{"format": "dd/MMM/YYYY"}'/>
                                                    </td>
                                                    <td>
                                                        <span t-field="book.author"/>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <!-- Notes Section -->
                                <div class="row">
                                    <div class="col-12">
                                        <strong>Notes:</strong>
                                        <p t-field="o.notes"/>
                                    </div>
                                </div>
                            </div>
                            <!-- New Footer Section -->
                            <div class="footer">
                                <div class="row mt-4">
                                    <div class="col-4">
                                        <span>www.aktivsoftware.com</span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </main>
            </body>
        </html>
    </template>

    <!-- library member report for mail attachment  -->
    <template id="report_member_card">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Member Details</h2>
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Member Name:</strong>
                                <span t-field="doc.member_id.name"/>
                                <br/>
                                <strong>Membership Date:</strong>
                                <span t-field="doc.membership_date"/>
                                <br/>
                                <strong>Books Borrowed : </strong>
                                <t t-foreach="doc.book_ids" t-as="book">
                                    <span t-field="book.name"/>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
