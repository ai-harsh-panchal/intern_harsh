<odoo>
    <!--Reminder cron job -->
    <record model="ir.cron" id="manager_pending_approvals">
        <field name="name">pending approval request</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_reminder_approvals()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
</odoo>
