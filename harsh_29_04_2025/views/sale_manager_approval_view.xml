<odoo>
    <data>
        <!-- List View of sale manager approval Model -->
        <record id="view_sale_manager_approval_tree" model="ir.ui.view">
            <field name="name">sales.manager.approval.list</field>
            <field name="model">sales.manager.approval</field>
            <field name="arch" type="xml">
                <list>
                    <field name="user_id"/>
                    <field name="approval_threshold"/>
                </list>
            </field>
        </record>

        <!-- Form View of sale manager approval Model -->
        <record id="view_sale_manager_approval_form" model="ir.ui.view">
            <field name="name">sales.manager.approval.form</field>
            <field name="model">sales.manager.approval</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div>
                            <group>
                                <field name="user_id"/>
                                <field name="approval_threshold"/>
                            </group>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for sale manager approval -->
        <record id="action_sale_manager_approval" model="ir.actions.act_window">
            <field name="name">Sale Manager Approval</field>
            <field name="res_model">sales.manager.approval</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Action for pending Approvals -->
        <record id="action_quotations_with_pending" model="ir.actions.act_window">
            <field name="name">Pending Approval</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list</field>
            <field name="domain">[('state', '=', 'pending_approval')]</field>
        </record>
    </data>
</odoo>
