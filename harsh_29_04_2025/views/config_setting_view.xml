<odoo>
    <!-- record for sale manager field in config setting -->
    <record id="sale_manager_config_settings_view" model="ir.ui.view">
        <field name="name">sale.config.settings.view.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='invite_users_setting']" position="after">
                <label for="sales_manager_ids" string="Sales Manager"/>
                <field name="sales_manager_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>
