<odoo>
    <data>
        <!-- pageformat for product catalog report -->
        <record id="product_catalog_paperformat" model="report.paperformat">
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
        </record>

        <!-- action for manage product catalog report -->
        <record id="action_product_catalog_report" model="ir.actions.report">
            <field name="name">Product Catalog Report</field>
            <field name="model">product.catalog.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ak_product_cataloge_pdf.product_catalog_report_template</field>
            <field name="report_file">ak_product_cataloge_pdf.product_catalog_report_template</field>
            <field name="paperformat_id" ref="ak_product_cataloge_pdf.product_catalog_paperformat"/>
            <field name="binding_model_id" ref="ak_product_cataloge_pdf.model_product_catalog_wizard"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>