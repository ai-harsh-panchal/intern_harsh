<odoo>
    <data>
        <!-- inherit sale order view -->
        <record id="custom_sale_order_view" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.form.view</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <group>
                        <field name="job_name" readonly="origin == True or state != 'draft'"/>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- inherit sale order search view -->
        <record id="view_order_filter_search_view" model="ir.ui.view">
            <field name="name">sale.order.filter.job.view</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <separator/>
                    <filter string="Job Name" name="job_name" domain="[('job_name', '!=', False)]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
