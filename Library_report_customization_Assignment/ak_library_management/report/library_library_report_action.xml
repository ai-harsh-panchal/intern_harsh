<odoo>
    <!--    Report action library-->
    <record id="action_library_report" model="ir.actions.report">
        <field name="name">library Report</field>
        <field name="model">library.library</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ak_library_management.library_report_template_details</field>
        <field name="report_file">ak_library_management.library_report_template_details</field>
        <field name="binding_model_id" ref="ak_library_management.model_library_library"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_custom_library_report" model="ir.actions.report">
        <field name="name">custom library Report</field>
        <field name="model">library.library</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ak_library_management.custom_library_qweb_report_template</field>
        <field name="report_file">ak_library_management.custom_library_qweb_report_template</field>
        <field name="binding_model_id" ref="ak_library_management.model_library_library"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_library_member" model="ir.actions.report">
        <field name="name">Member Card</field>
        <field name="model">library.member</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ak_library_management.report_member_card</field>
        <field name="report_file">ak_library_management.report_member_card</field>
        <field name="binding_model_id" ref="ak_library_management.model_library_member"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
