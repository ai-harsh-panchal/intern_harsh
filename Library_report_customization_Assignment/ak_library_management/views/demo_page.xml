<odoo>
    <template id="demo_page_template">
        <t t-call="website.layout">
            <div class="container">
                <h4>Welcome to My Odoo Ak library Management Module!</h4>
                <p>This is a demo page created to showcase the functionality of the controller.</p>
                <p>Feel free to explore the features and functionalities of this module.</p>
            </div>
        </t>
    </template>

    <template id="res_partner_template">
        <t t-call="website.layout">
            <div class="container">
                <h4>Welcome to Res Contact Partners</h4>
                <div class="row">
                    <div class="col-md-12">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="partners" t-as="partner">
                                    <tr>
                                        <td>
                                            <a t-att-href="'/partner/%s' % partner.id">
                                                <t t-esc="partner.name"/>
                                            </a>
                                        </td>
                                        <td>
                                            <a t-att-href="'/partner/%s' % partner.id" class="btn btn-primary btn-sm">
                                                View Details
                                            </a>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Partner Details Template -->
    <template id="partner_detail_template">
        <t t-call="website.layout">
            <div class="container">
                <h4>Partner Details</h4>
                <div class="row">
                    <div class="col-md-6 offset-md-3">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title"><t t-esc="partner.name"/></h5>
                                <p><strong>Email:</strong> <t t-esc="partner.email or 'N/A'"/></p>
                                <p><strong>Phone:</strong> <t t-esc="partner.phone or 'N/A'"/></p>
                                <p><strong>Address:</strong> <t t-esc="partner.contact_address or 'N/A'"/></p>
                                <p><strong>Company:</strong> <t t-esc="partner.company_id.name or 'N/A'"/></p>

                                <a href="/contacts" class="btn btn-secondary">Back to Partner List</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <data>
        <record id="menu_website_custom" model="website.menu">
            <field name="name">Ak Library Management</field>
            <field name="url">/demo</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" eval="10"/>
        </record>

        <record id="partner_website_custom" model="website.menu">
            <field name="name">Res Partner</field>
            <field name="url">/contacts</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" eval="20"/>
        </record>
    </data>
</odoo>
