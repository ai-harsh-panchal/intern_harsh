<odoo>
    <data>
        <!-- Inherit header footer article for invoice report -->
        <template id="invoice_custom_header_inherit_web" inherit_id="web.external_layout_standard">
            <xpath expr="//div[@name='company_address']" position="replace">
                <t t-if="o._name == 'account.move' and o.move_type == 'out_invoice'">
                    <div class="row" style="margin-top: 20px; margin-left:12px; padding-bottom:20px;">
                        <div class="col-7" style="text-align: left;">
                            <table style="width: 100%;" class="table-borderless">
                                <tr>
                                    <td style="width: 150px;">Invoice Reference:</td>
                                    <td>
                                        <span t-field="o.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Invoice Date:</td>
                                    <td>
                                        <span t-field="o.invoice_date" t-options='{"format": "dd/MM/yyyy"}'/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Reference Period:</td>
                                    <td>
                                        <span>
                                            <t t-esc="o.invoice_date"
                                               t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/> <!-- Example: 01/04/2024 -->
                                            To
                                            <t t-esc="o.invoice_date_due"
                                               t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/> <!-- Example: 30/04/2024 -->
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Payment Term:</td>
                                    <td>
                                        <span t-field="o.invoice_payment_term_id"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-5 text-right ms-1">
                            <div style="margin-left: 15px;">
                                <strong>
                                    <span t-field="o.partner_id.name"/>
                                </strong>
                                <address class="mb-0">
                                    <strong>
                                        <span t-field="o.partner_id"
                                              t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                                    </strong>
                                </address>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'article')]" position="attributes">
            <attribute name="t-attf-class">article o_report_layout_standard o_company_#{company.id}_layout
                o_snail_mail {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}
            </attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_footer_content')]" position="replace">
            <div class="o_footer_content d-flex justify-content-center pt-2"
                 style="color: darkblue; font-size: 14px; font-weight: bold; border-top: none;">
                <div class="text-center">
                    <span>Nolen, Winker and Partners - 33, rue de Gasperich, L- 5826 Hesperange - VAT LU31980427
                    </span>
                </div>
            </div>
        </xpath>
    </template>

    <!-- inherit article elements of invoice report -->
    <template id="report_invoice_document_inherit_elements" inherit_id="account.report_invoice_document">
        <xpath expr="//td[@name='td_taxes']" position="replace">
        </xpath>
        <xpath expr="//span[@id='payment_terms_note_id']" position="replace">
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="replace">
        </xpath>
        <xpath expr="//div[@id='right-elements']" position="attributes">
            <attribute name="t-attf-class"/>
        </xpath>
        <xpath expr="//t[@t-call='account.document_tax_totals_company_currency_template']" position="attributes">
            <attribute name="t-if">not o</attribute>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']" position="before">
            <style>
                th {
                font-weight: bold;
                }
            </style>
        </xpath>
        <xpath expr="//div[@id='payment_term']" position="attributes">
            <attribute name="style">margin-top: 100px; margin-left:12px;</attribute>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']" position="after">
            <div style="margin-top: 60px;"></div>
        </xpath>
        <xpath expr="//div[@id='informations']" position="replace">
            <div/>
        </xpath>
        <xpath expr="//td[@name='td_price_unit']" position="replace">
            <td name="td_price_unit"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"
                t-options='{"widget": "monetary","display_currency": o.currency_id}'>
                <span class="text-nowrap" t-field="line.price_unit">9.00</span>
            </td>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <div class="fw-bold" style="font-size: 20px; margin-left:12px; margin-bottom: 80px; padding-top:50px;">
                <span>INVOICE</span>
            </div>
        </xpath>
        <xpath expr="//div[@name='address_same_as_shipping']" position="replace">
            <div/>
        </xpath>
    </template>

    <!-- inherit document tax totals template -->
    <template id="custom_document_tax_totals" inherit_id="account.document_tax_totals_template">
        <xpath expr="//tr[@class='o_taxes']/t/td/span[@class='text-nowrap']" position="attributes">
            <attribute name="style">font-weight: bold;</attribute>
        </xpath>
        <xpath expr="//tr[@class='o_subtotal']/td" position="attributes">
            <attribute name="style">font-weight: bold;</attribute>
        </xpath>
    </template>
</data>
        </odoo>
