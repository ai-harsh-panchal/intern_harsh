<odoo>
    <record id="view_warehouse_library_form" model="ir.ui.view">
        <field name="name">stock.warehouse.library.form</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="library_assistant_id" groups="ak_library_management.group_library_admin"/>
                <field name="worker_id" widget="many2many_tags" groups="ak_library_management.group_library_admin,ak_library_management.group_library_assistant"/>
            </xpath>
        </field>
    </record>
</odoo>
