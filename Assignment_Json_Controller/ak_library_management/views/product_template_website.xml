<odoo>
    <!-- inherit product template -->
    <template id="product_image_download_custom" inherit_id="website_sale.product">
        <xpath expr="//div[@id='o_product_terms_and_share']" position="after">
            <t t-if="product.image_1920 or product.product_template_image_ids">
                <a class="btn btn-primary"
                   t-att-href="'/download_product_image/' + str(product.id)">
                    Download Image
                </a>
            </t>
        </xpath>
    </template>

    <!-- Add on hand quantity in product information -->
    <template id="product_on_hand_qty_view" inherit_id="website_sale.products_item">
        <xpath expr="//div[contains(@class, 'o_wsale_product_information_text')]" position="inside">
            <div class="on_hand_quantity mt-2">
                <span>On Hand:
                    <span t-field="product.sudo().qty_available"/>
                </span>
            </div>
        </xpath>
    </template>

    <!-- add to cart button in product item view -->
    <template id="add_to_cart_button_view" inherit_id="website_sale.products_item">
        <xpath expr="//div[contains(@class, 'o_wsale_product_sub d-flex')]" position="after">
            <div id="add_to_cart_wrap" t-attf-class="d-inline-flex align-items-center mb-2 me-auto">
                <a role="button" id="add_to_cart"
                   t-attf-class="btn btn-primary js_check_product a-submit flex-grow-1 #{'btn-lg' if ctaSizeBig else ''}"
                   href="#">
                    <i class="fa fa-shopping-cart me-2"/>
                    <span>Add to cart</span>
                </a>
            </div>
        </xpath>
    </template>
</odoo>
