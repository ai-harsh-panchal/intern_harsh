<odoo>
    <record id="res_config_settings_view_form_library" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.library</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='module_base_import']" position="after">
                <group>
                    <field name="library_book_limit"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
